# Copia este archivo como frontend/.env.local y rellena los valores. .env.local NO se sube a git.
# Next.js solo lee el .env.local de esta carpeta (frontend/).

# --- Supabase (Project Settings > API Keys) ---
# URL del proyecto y clave publishable (sb_publishable_...): seguras para el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- NASA (solo servidor: API routes) ---
# NASA POWER no necesita clave. Esta es para api.nasa.gov (https://api.nasa.gov) y,
# el 14 de noviembre, para las credenciales que entregue el hackatón.
NASA_API_KEY=DEMO_KEY
